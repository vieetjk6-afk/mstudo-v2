# ═════════════════════════════════════════════════════════════════════════════
# BIẾN MÔI TRƯỜNG CỦA MÁY CHỦ Ở NHÀ
#
#   cp .env.example .env   (cai-dat.sh tự làm nếu .env chưa có)
#   nano .env              → điền giá trị thật
#   chmod 600 .env         → chỉ chủ máy đọc được
#
# File .env KHÔNG BAO GIỜ được commit (.gitignore đã chặn) và không được gửi
# cho ai. Nó chứa khoá toàn quyền vào database (SUPABASE_SERVICE_ROLE_KEY).
#
# QUY TẮC ĐƠN GIẢN: giá trị phải GIỐNG HỆT bên Vercel (Project → Settings →
# Environment Variables → Production) — máy nhà và Vercel dùng chung một
# Supabase, một CRON_SECRET, một INBOX_INGEST_SECRET… Lệch một biến là một tính
# năng hỏng âm thầm. Mẹo: `npx vercel env pull` trên máy lập trình rồi chép sang.
#
# CÚ PHÁP:
#   • Mỗi dòng KEY=giá-trị. KHÔNG viết chú thích ở cuối dòng (# …) — phần đó sẽ
#     bị coi là một phần của giá trị.
#   • Giá trị có ký tự `$` (hay gặp trong JSON của CHAT_PROVIDERS, mật khẩu)
#     phải bọc trong NHÁY ĐƠN: KEY='abc$def' — không thì docker compose hiểu `$def`
#     là tên biến và thay bằng chuỗi rỗng.
#
# Bỏ trống = tính năng đó tắt (giống hệt trên Vercel). Danh sách đầy đủ và cách
# xử lý từng biến: docs/bien-moi-truong.md và .env.example ở gốc repo.
# ═════════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────────
# 1. RIÊNG CỦA MÁY Ở NHÀ (Vercel không có các biến này)
# ─────────────────────────────────────────────────────────────────────────────

# Token của Cloudflare Tunnel. Lấy ở Cloudflare Zero Trust → Networks → Tunnels
# → Create a tunnel → Cloudflared → đặt tên → chọn "Docker" → chép chuỗi dài
# sau `--token`. (HUONG-DAN.md bước 5.) BÍ MẬT: ai có token này là mạo danh
# được máy chủ của bạn.
TUNNEL_TOKEN=

# Tên miền phụ của máy media — đúng hostname đã khai trong tunnel (Public
# Hostname). Chỉ là tên máy trần: không https://, không dấu / ở cuối.
MEDIA_HOST=media.mstudo.com

# Địa chỉ đầy đủ của máy media. Ở máy nhà biến này chỉ để proxy nhận ra chính
# nó; biến QUAN TRỌNG là bản cùng tên đặt trên VERCEL (HUONG-DAN.md bước 8) —
# trình duyệt đọc bản đó để biết hỏi máy media trước.
NEXT_PUBLIC_MEDIA_ORIGIN=https://media.mstudo.com

# Hạn cho MỘT lượt quét khuôn mặt (mili-giây). Vercel Hobby cắt hàm ở 60 giây
# nên mặc định chỉ 45000 (~30 ảnh/lượt). Máy nhà không bị cắt → 240000 (~160
# ảnh/lượt). Trần code cho phép: 280000.
FACE_SCAN_BUDGET_MS=240000

# Tắt hẳn bộ quét khuôn mặt (=1). Để trống = bật.
FACE_SCAN_OFF=

# ── Bộ hẹn giờ (container `cron`) — true/false ──
# Quét khuôn mặt mỗi 10 phút, gọi thẳng app trong máy. Nhớ đặt biến repo
# GitHub FACE_SCAN_ON_HOME=true để GitHub Actions ngừng quét trùng.
HOME_CRON_FACE_SCAN=true
# Số lượt gọi tối đa mỗi vòng 10 phút (mỗi lượt tối đa FACE_SCAN_BUDGET_MS).
FACE_SCAN_ROUNDS=8
# Ba việc DỌN DẸP hằng ngày (cleanup-proofs, cleanup-drive-cache,
# cleanup-wedding-photos). Chạy trùng với Vercel cũng vô hại (xoá cái đã xoá
# thì không còn gì để xoá), và máy nhà không bị cắt ở 60 giây như gói Hobby.
HOME_CRON_CLEANUP=false
# Bốn việc GỬI TIN hằng ngày (automations, reminders, zalo money/work).
# CHỈ bật khi đã TẮT Cron Jobs trên Vercel — không thì khách nhận tin 2 lần.
HOME_CRON_DAILY=false

# BUILD_STANDALONE, MEDIA_ONLY, DEPLOY_ENV, GIT_COMMIT_SHA: KHÔNG cần khai ở
# đây — Dockerfile/docker-compose.yml/cap-nhat.sh tự đặt.


# ─────────────────────────────────────────────────────────────────────────────
# 2. BẮT BUỘC — thiếu là app không chạy
# ─────────────────────────────────────────────────────────────────────────────

# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Khoá toàn quyền — BÍ MẬT TUYỆT ĐỐI.
SUPABASE_SERVICE_ROLE_KEY=

# Khoá Google Drive API (đọc thư mục album, tải ảnh để quét khuôn mặt).
GOOGLE_API_KEY=
# Referer khai kèm khi gọi Drive API — khớp giới hạn "HTTP referrers" của khoá.
# Bỏ trống → tự dùng https://<NEXT_PUBLIC_MAIN_HOST>/ (giống Vercel).
GOOGLE_API_REFERER=

# Khoá bảo vệ /api/cron/* — PHẢI trùng Vercel và secret CRON_SECRET trên GitHub.
CRON_SECRET=

# Bí mật dùng chung giữa worker Zalo và /api/inbox/ingest — trùng Vercel.
INBOX_INGEST_SECRET=

# Khoá giải mã phiên Zalo cá nhân — PHẢI trùng Vercel, không thì worker không
# đọc được phiên mà app đã lưu (bỏ trống ở cả hai nơi thì cả hai cùng rơi về
# OAUTH_STATE_SECRET / SUPABASE_SERVICE_ROLE_KEY).
ZALO_SESSION_SECRET=
OAUTH_STATE_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# 3. TÊN MIỀN — giống Vercel (proxy dùng để nhận ra host nào là gì)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAIN_HOST=mstudo.com
NEXT_PUBLIC_APP_HOST=album.mstudo.com
NEXT_PUBLIC_IMG_HOST=img.mstudo.com
NEXT_PUBLIC_ADMIN_HOST=admin.mstudo.com
NEXT_PUBLIC_THIEP_HOST=thiep.mstudo.com
NEXT_PUBLIC_STUDIO_HOST=


# ─────────────────────────────────────────────────────────────────────────────
# 4. ẢNH (/api/img) — giống Vercel, hoặc để trống
# ─────────────────────────────────────────────────────────────────────────────
# Bucket Supabase làm cache ảnh. Máy nhà không tốn Fast Origin Transfer nên có
# thể để TRỐNG: byte đi thẳng Google → máy nhà → Cloudflare (Cloudflare cache
# lại, xem HUONG-DAN.md mục Cache Rule) mà không tốn egress Supabase.
DRIVE_IMG_CACHE_BUCKET=
DRIVE_IMG_CACHE_MAX_AGE_DAYS=
DRIVE_IMG_CACHE_MAX_BYTES=
DRIVE_IMG_CACHE_ORIGINALS=
DRIVE_IMG_CACHE_MAX_WIDTH=
IMG_CDN_REDIRECT=


# ─────────────────────────────────────────────────────────────────────────────
# 5. HỘP THƯ + AI TRẢ LỜI — cần vì worker Zalo đẩy tin vào app ở nhà, và chính
#    app ở nhà gọi AI trả lời + gửi lại qua Zalo/Meta. Chép nguyên từ Vercel.
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=
# JSON một dòng; có `$` thì bọc nháy đơn (xem phần CÚ PHÁP ở đầu file).
CHAT_PROVIDERS=
ZALO_OA_APP_ID=
ZALO_OA_APP_SECRET=
ZALO_OA_REDIRECT_URI=
ZALO_OA_WEBHOOK_SECRET=
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_REDIRECT_URI=
META_LOGIN_CONFIG_ID=
META_GRAPH_BASE=


# ─────────────────────────────────────────────────────────────────────────────
# 6. THÔNG BÁO + EMAIL — để việc chạy ở nhà (tin mới, việc định kỳ) báo được
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
RESEND_API_KEY=
EMAIL_FROM=


# ─────────────────────────────────────────────────────────────────────────────
# 7. CÒN LẠI — máy media không phục vụ các trang dùng tới chúng, nhưng chép
#    sang cho đủ bộ (một route sau này chuyển về nhà sẽ không hỏng âm thầm).
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_STORY_REDIRECT_URI=
GOOGLE_ADMIN_DRIVE_REDIRECT_URI=
GOOGLE_FILTER_DRIVE_REDIRECT_URI=
GOOGLE_STUDIO_DRIVE_REDIRECT_URI=
GOOGLE_CALENDAR_REDIRECT_URI=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=
NEXT_PUBLIC_DESKTOP_RELEASES_REPO=
NEXT_PUBLIC_SEPAY_REF_URL=
SEPAY_MSTUDO_KEY=
CSP_REPORT_ONLY=
# Chỉ dùng để app tự đăng ký tên miền của studio với Vercel — máy nhà không
# làm việc đó; để trống cũng được.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
