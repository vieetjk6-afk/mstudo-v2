
# ═════════════════════════════════════════════════════════════════════════════
# PHẦN RIÊNG CHO MINIPC (tự host) — nối vào cuối file .env
# ═════════════════════════════════════════════════════════════════════════════

# Token của Cloudflare Tunnel (Zero Trust → Networks → Tunnels → Create →
# Cloudflared → chọn Docker → copy chuỗi dài sau "--token"). BÍ MẬT.
CLOUDFLARE_TUNNEL_TOKEN=

# BẮT BUỘC đặt — thiếu là container cron dừng và mọi cron trả 401.
# Tạo: openssl rand -hex 32
# CRON_SECRET=   (biến này đã có ở phần trên của file, điền ở đó)

# Domain công khai của app — dùng cho tiến trình Zalo cá nhân (profile zalo).
MSTUDO_URL=https://mstudo.com

# Ghi mã commit vào /api/version (tuỳ chọn). Script cap-nhat.sh tự điền.
GIT_SHA=

# Tự host thì KHÔNG dùng API tên miền của Vercel: để trống 3 biến
# VERCEL_TOKEN / VERCEL_PROJECT_ID / VERCEL_TEAM_ID ở phần trên.
