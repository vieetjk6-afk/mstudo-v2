# ─────────────────────────────────────────────────────────────────────────────
# Biến môi trường trên VPS.
#
# Chép file này lên VPS thành /var/www/mstudo/shared/.env rồi điền giá trị thật:
#     sudo -u mstudo nano /var/www/mstudo/shared/.env
#     sudo chmod 600 /var/www/mstudo/shared/.env      ← chỉ user mstudo đọc được
#
# File này nằm NGOÀI thư mục release nên deploy không ghi đè. Sửa xong phải
# khởi động lại thì tiến trình mới nhận giá trị mới:
#     sudo systemctl restart mstudo
#
# ⚠️ CÁCH VIẾT GIÁ TRỊ: systemd đọc file này (EnvironmentFile), KHÔNG phải bash.
#    Luật đơn giản hơn shell:
#      • Mỗi dòng một cặp  TÊN=giá trị
#      • Dấu cách trong giá trị KHÔNG cần bọc nháy:
#            EMAIL_FROM=mstudo <no-reply@mstudo.com>
#      • Nếu có bọc nháy thì systemd tự bỏ cặp nháy ngoài cùng — viết
#            VAPID_SUBJECT=mailto:khoa@mstudo.com   cũng ra kết quả đúng
#      • KHÔNG có nội suy biến: $KHAC là ký tự thật, không bị thay thế.
#        Nhờ vậy khoá bí mật chứa $ không bị biến dạng.
#      • Dấu # chỉ là chú thích khi đứng ĐẦU dòng. Giữa dòng nó là ký tự thường.
#      • Không xuống dòng giữa một giá trị.
#
# Giải thích đầy đủ từng biến: xem docs/bien-moi-truong.md
# ─────────────────────────────────────────────────────────────────────────────


# ══ RIÊNG CHO VPS — không có trên Vercel ═════════════════════════════════════

# IP công khai của VPS. Bật chế độ VPS cho tính năng tên miền riêng của studio
# (/api/site/domain): thay vì gọi Vercel API, app tra DNS xem tên miền của khách
# đã trỏ về IP này chưa, còn chứng chỉ HTTPS thì Caddy tự lo.
# ⚠️ Để trống biến này thì tính năng tên miền riêng sẽ HỎNG sau khi rời Vercel.
SERVER_IP=203.0.113.10

# (Tuỳ chọn) Che endpoint /api/tls/allow — endpoint Caddy hỏi trước khi cấp
# chứng chỉ HTTPS cho một tên miền lạ. Đặt biến này thì phải sửa deploy/Caddyfile
# thành:  ask http://127.0.0.1:3000/api/tls/allow?token=<đúng chuỗi này>
# Bỏ trống cũng an toàn: endpoint chỉ trả lời "tên miền này có trong hệ thống
# không", không tự cấp được chứng chỉ nào.
# Sinh chuỗi: openssl rand -hex 24
TLS_ASK_SECRET=


# ══ SUPABASE ═════════════════════════════════════════════════════════════════
# Giai đoạn 1 (chỉ chuyển Next.js): giữ nguyên giá trị đang dùng trên Vercel.
# Giai đoạn 2 (tự dựng Supabase): đổi URL sang https://db.mstudo.com và thay hai
# khoá bằng khoá do bộ self-host sinh ra.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ══ TÊN MIỀN ═════════════════════════════════════════════════════════════════
# Phải khớp với danh sách host trong deploy/Caddyfile.

NEXT_PUBLIC_MAIN_HOST=mstudo.com
NEXT_PUBLIC_IMG_HOST=img.mstudo.com
NEXT_PUBLIC_ADMIN_HOST=admin.mstudo.com
NEXT_PUBLIC_THIEP_HOST=thiep.mstudo.com
NEXT_PUBLIC_APP_HOST=album.mstudo.com
NEXT_PUBLIC_STUDIO_HOST=


# ══ CRON ═════════════════════════════════════════════════════════════════════
# Chuỗi bí mật để các route /api/cron/* biết lời gọi đến từ máy chủ chứ không
# phải người lạ. deploy/cron-run.sh đọc đúng biến này.
# Sinh chuỗi mới: openssl rand -hex 32
CRON_SECRET=


# ══ GOOGLE (Drive, Calendar, đăng nhập, Picker) ══════════════════════════════
# ⚠️ Các REDIRECT_URI phải được khai báo y hệt trong Google Cloud Console →
#    APIs & Services → Credentials → OAuth client → Authorized redirect URIs.
#    Giữ nguyên tên miền khi chuyển sang VPS thì KHÔNG phải sửa gì ở Google.

NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_API_KEY=
GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
GOOGLE_API_REFERER=

GOOGLE_ADMIN_DRIVE_REDIRECT_URI=https://admin.mstudo.com/api/admin/drive/callback
GOOGLE_STUDIO_DRIVE_REDIRECT_URI=https://mstudo.com/api/studio/drive/callback
GOOGLE_FILTER_DRIVE_REDIRECT_URI=https://mstudo.com/api/filter/drive/callback
GOOGLE_STORY_REDIRECT_URI=https://mstudo.com/api/story/drive/callback
GOOGLE_CALENDAR_REDIRECT_URI=https://mstudo.com/api/gcal/callback

# Ký tham số `state` của OAuth để chống giả mạo. openssl rand -hex 32
OAUTH_STATE_SECRET=


# ══ EMAIL ════════════════════════════════════════════════════════════════════
RESEND_API_KEY=
EMAIL_FROM=mstudo <no-reply@mstudo.com>


# ══ THÔNG BÁO ĐẨY (Web Push) ═════════════════════════════════════════════════
# Sinh cặp khoá: npx web-push generate-vapid-keys
# ⚠️ ĐỔI KHOÁ = mọi thiết bị đã đăng ký nhận thông báo bị mất kết nối và phải
#    đăng ký lại. Khi chuyển sang VPS hãy GIỮ NGUYÊN cặp khoá cũ.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:khoa@mstudo.com


# ══ CHỐNG BOT (Cloudflare Turnstile) ═════════════════════════════════════════
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# ══ ZALO ═════════════════════════════════════════════════════════════════════
ZALO_OA_APP_ID=
ZALO_OA_APP_SECRET=
ZALO_OA_REDIRECT_URI=https://mstudo.com/api/studio/zalo/callback
ZALO_SESSION_SECRET=


# ══ AI (trợ lý chat trên website studio) ═════════════════════════════════════
GEMINI_API_KEY=
GEMINI_MODEL=
CHAT_PROVIDERS=


# ══ CACHE ẢNH DRIVE ══════════════════════════════════════════════════════════
DRIVE_IMG_CACHE_BUCKET=
DRIVE_IMG_CACHE_MAX_AGE_DAYS=
DRIVE_IMG_CACHE_MAX_BYTES=
DRIVE_IMG_CACHE_MAX_WIDTH=
DRIVE_IMG_CACHE_ORIGINALS=
IMG_CDN_REDIRECT=


# ══ ĐÓNG DẤU CHÌM (watermark ảnh tải về) ═════════════════════════════════════
# Đóng dấu chạy ở PHÍA MÁY CHỦ (/api/img/watermark), không còn dùng canvas trong
# trình duyệt. Cần font hệ thống — setup-vps.sh đã cài fonts-dejavu-core.
#
# Đánh đổi CPU ↔ băng thông, đo trên ảnh 2560px chi tiết cao:
#   WATERMARK_MOZJPEG=1 (mặc định)  ~510–1100 ms/ảnh  file nhỏ hơn nguồn ~17%
#   WATERMARK_MOZJPEG=0             ~180 ms/ảnh       file xấp xỉ bằng nguồn
# Trên VPS cứ để mặc định: CPU không tính tiền, băng thông thì tiết kiệm được.
WATERMARK_MOZJPEG=
# Chất lượng JPEG đầu ra, 60–100. Mặc định 90.
WATERMARK_QUALITY=

# ══ APP DESKTOP ══════════════════════════════════════════════════════════════
DESKTOP_LATEST_VERSION=
DESKTOP_UPDATE_NOTE=
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=
NEXT_PUBLIC_DESKTOP_RELEASES_REPO=


# ══ KHÔNG CÒN DÙNG TRÊN VPS ══════════════════════════════════════════════════
# VERCEL_TOKEN / VERCEL_PROJECT_ID / VERCEL_TEAM_ID
#   Chỉ dùng để đăng ký tên miền riêng của studio lên Vercel. Trên VPS việc đó
#   do SERVER_IP + Caddy đảm nhiệm. ĐỪNG đặt các biến này trên VPS — nếu đặt,
#   app vẫn ưu tiên SERVER_IP, nhưng để đó chỉ tổ gây nhầm lẫn về sau.
#
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
#   Có trong .env.example nhưng code KHÔNG dùng — rate-limit đếm trong bộ nhớ
#   tiến trình. Trên VPS chỉ có một tiến trình nên cách đếm này còn chính xác
#   hơn lúc chạy serverless. Bỏ qua hai biến này.
