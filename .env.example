# ─────────────────────────────────────────────────────────────
# Vieetjk Photo Collection — Environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it contains secrets.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server only, used for admin operations (managing photographers).
# Keep this SECRET. Do not expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Drive API key — server only (used to list folder contents).
# Restrict it to the Drive API in Google Cloud Console.
GOOGLE_API_KEY=your-google-api-key

# Khoá bảo vệ 5 route /api/cron/* (nhắc lịch, gửi Zalo, dọn cache…). Vercel tự
# gắn "Authorization: Bearer $CRON_SECRET" khi chạy cron trong vercel.json.
# FAIL-CLOSED: bỏ trống thì mọi cron trả 401 và im lặng ngừng chạy — nhớ đặt ở
# project Vercel (đặt chuỗi ngẫu nhiên dài, giữ bí mật).
CRON_SECRET=

# ── /api/img durable cache (giảm Fast Origin Transfer của Vercel) ─────────
# Không bắt buộc. Khi đặt tên một bucket Supabase Storage PUBLIC, /api/img sẽ
# lưu ảnh đã proxy vào bucket đó và các lần sau chuyển hướng (302) thẳng tới
# CDN của Supabase — Vercel gần như không phải phục vụ byte ảnh nào nữa.
# Cách bật: Supabase → Storage → tạo bucket public (vd "drive-cache") rồi đặt:
#   DRIVE_IMG_CACHE_BUCKET=drive-cache
# Bỏ trống = chỉ proxy + cache ở CDN Vercel (vẫn giảm tải nhờ s-maxage).
#
# ⚠ ĐÁNH ĐỔI QUOTA: bucket này ĂN CẢ HAI hạn mức Supabase — mỗi object nằm
# trong FILE STORAGE (free 1 GB) và mỗi byte nó phục vụ tính vào EGRESS (free
# 5 GB). Nó chỉ đáng dùng cho ảnh NHỎ và được xem NHIỀU LẦN (thumbnail gallery).
# Byte to & đọc-một-lần (bản gốc, ảnh cỡ tải về) thì để chảy thẳng từ Google qua
# Vercel — băng thông Vercel rẻ hơn nhiều. Hai công tắc dưới đây giữ đúng ranh
# giới đó. Ảnh HIỂN THỊ vẫn redirect thẳng sang CDN Google (miễn phí), KHÔNG bao
# giờ vào Supabase. Cron /api/cron/cleanup-drive-cache dọn theo tuổi + trần dung
# lượng mỗi ngày.
DRIVE_IMG_CACHE_BUCKET=

# Số ngày giữ 1 ảnh trong cache Supabase trước khi cron dọn (mặc định 21). Ảnh bị
# dọn sẽ tự cache lại khi có người xem lại (1 lần fetch qua Vercel). Tăng nếu
# muốn cache lâu hơn (đỡ cache-miss), giảm nếu muốn tiết kiệm storage Supabase.
DRIVE_IMG_CACHE_MAX_AGE_DAYS=

# TRẦN DUNG LƯỢNG cứng của bucket cache, tính bằng BYTE (mặc định 500 MB).
# Chỉ dọn theo tuổi là KHÔNG đủ: một tháng đông khách làm đầy bucket từ lâu
# trước khi có file nào đủ 21 ngày tuổi — đó chính là cách 1 GB free bị vượt.
# Sau lượt dọn theo tuổi, cron xoá tiếp file CŨ NHẤT cho tới khi bucket lọt trần.
#   500 MB = 524288000 · 300 MB = 314572800 · 800 MB = 838860800
DRIVE_IMG_CACHE_MAX_BYTES=

# Có cache ẢNH GỐC (?orig=1) vào Supabase không. MẶC ĐỊNH TẮT — đặt =1 để bật.
# Ảnh gốc là byte NẶNG NHẤT route /api/img phục vụ: một lần tải ZIP của trọn bộ
# ảnh cưới có thể đẩy vài trăm MB vào bucket rồi trả đúng ngần ấy ra egress.
# Khi tắt, ảnh gốc chảy thẳng từ Google qua Vercel (Supabase tốn 0 byte).
# Chỉ bật khi hạn mức Supabase còn rộng và muốn giảm Fast Origin Transfer.
DRIVE_IMG_CACHE_ORIGINALS=

# Chỉ cache ảnh có chiều rộng ≤ giá trị này (mặc định 1024). Thumbnail (w≤1024)
# được mọi người xem album dùng lại nên cache rất lợi; còn bản w=2000/2560 chỉ
# fetch đúng một lần lúc tải về/đóng watermark — cache vào chỉ tốn storage.
DRIVE_IMG_CACHE_MAX_WIDTH=

# ── Giảm Vercel "Fast Origin Transfer" + Active CPU cho ảnh ─────────────────
# MẶC ĐỊNH ĐÃ BẬT: /api/img 302-redirect các ảnh HIỂN THỊ (<img>) thẳng sang CDN
# của Google nên Vercel phục vụ ~0 byte ảnh (giảm mạnh Fast Origin Transfer —
# một gallery tải hàng trăm thumbnail). Tải ZIP/fetch/canvas vẫn qua proxy để
# đọc byte cùng-origin (bytes chuẩn). Watermark hiển thị là lớp phủ CSS nên
# không bị ảnh hưởng. Đặt =0 để TẮT (quay lại proxy như cũ) nếu có ảnh không
# hiện. Khi đã đặt DRIVE_IMG_CACHE_BUCKET ở trên thì dùng đường đó (bỏ qua cờ này).
IMG_CDN_REDIRECT=

# ── Google Picker (compress tool: pick + write back to a user's own Drive) ──
# Lets ANY signed-in Google user compress images on their OWN Drive using the
# non-sensitive `drive.file` scope (no Google verification / no warning screen).
# Create an OAuth Web client + an API key in the same Google Cloud project, and
# enable the "Google Picker API". Leave unset to hide the picker (link mode only).
#   CLIENT_ID -> OAuth 2.0 Web client ID (add your site origins to "Authorized JS origins")
#   API_KEY   -> browser API key (restrict to your domains + the Picker API)
#   APP_ID    -> the Google Cloud project NUMBER (for drive.file Picker access)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-oauth-web-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_API_KEY=your-browser-api-key
NEXT_PUBLIC_GOOGLE_APP_ID=your-gcp-project-number

# ── Love Story: guest uploads to the couple's own Drive (Cách 1) ──────────
# Lets a wedding couple connect THEIR Google Drive so guests can upload photos/
# videos straight into it (server-side, drive.file scope → no Google review).
# Reuses the OAuth Web client above (NEXT_PUBLIC_GOOGLE_CLIENT_ID) + its secret.
#   GOOGLE_CLIENT_SECRET      -> the OAuth Web client secret (server only, SECRET)
#   GOOGLE_STORY_REDIRECT_URI -> must exactly match an "Authorized redirect URI"
#                                on that OAuth client, e.g.
#                                https://mstudo.com/api/story/drive/callback

# ── Admin Drive: store USER-uploaded content on the admin's Google Drive ────
# Reuses the same OAuth Web client + GOOGLE_CLIENT_SECRET above. Admin connects
# their Drive once (Cài đặt hệ thống → Kết nối Google Drive); user uploads then
# go to a dedicated folder there instead of Supabase Storage. Also run the
# schema.sql migration (adds site_settings.drive_refresh_token / drive_folder_id).
#   GOOGLE_ADMIN_DRIVE_REDIRECT_URI -> an "Authorized redirect URI" on the OAuth
#                                client, e.g. https://mstudo.com/api/admin/drive/callback
GOOGLE_ADMIN_DRIVE_REDIRECT_URI=
# Leave unset to hide the "Nối Google Drive" button (link-folder mode still works).

# ── Lọc ảnh: connect once → auto copy filtered photos into ANY editable link ──
# Filter tool copies picked photos into a "Anh Chon" sub-folder of the ORIGINAL
# Drive link, server-side, with NO re-login. The studio connects Drive ONCE
# (full `drive` scope, offline) and the server reuses the refresh token forever.
# `drive` is a RESTRICTED scope → the consent screen shows an "unverified app"
# warning until the app passes Google verification (studio clicks Advanced →
# Continue). Reuses the same OAuth Web client + GOOGLE_CLIENT_SECRET above; add
# this exact redirect URI to that client and run schema.sql (adds
# studio_drive.filter_refresh_token).
#   GOOGLE_FILTER_DRIVE_REDIRECT_URI -> e.g. https://mstudo.com/api/filter/drive/callback
GOOGLE_FILTER_DRIVE_REDIRECT_URI=
# Leave unset to hide the "Kết nối Google Drive" button in the filter tool.
GOOGLE_CLIENT_SECRET=your-oauth-web-client-secret
GOOGLE_STORY_REDIRECT_URI=https://mstudo.com/api/story/drive/callback
# ── MStudo Desktop: đồng bộ ảnh/video hợp đồng lên Drive của studio ─────────
# Kết nối Drive RIÊNG theo từng studio (per-owner OAuth, drive.file). Dùng lại
# OAuth Web client + GOOGLE_CLIENT_SECRET ở trên. Chủ studio kết nối một lần tại
# Dashboard → Khách hàng → Đồng bộ Drive; khi hợp đồng đã ký, client tạo cây
# thư mục ảnh/video và tải lên Drive (1 chiều). Cần chạy migration
# supabase/migrations/studio_drive_sync.sql (bảng studio_drive + cột drive_* trên
# studio_contracts). Đọc album vẫn qua GOOGLE_API_KEY (thư mục JPG Goc/File
# ChinhSua được đặt công khai ai-có-link).
#   GOOGLE_STUDIO_DRIVE_REDIRECT_URI -> một "Authorized redirect URI" trên OAuth
#                                client, vd https://mstudo.com/api/studio/drive/callback
GOOGLE_STUDIO_DRIVE_REDIRECT_URI=

# ── Domain split (optional) ──────────────────────────────────────────────
# Set these to serve the public site, the app, and the image tools on separate
# hosts:
#   MAIN_HOST   -> landing, public sites/showcase, STUDIO management
#                  (/dashboard/studio, galleries) + client portals (/c /q /crew)
#   APP_HOST    -> login, album dashboard (create/filter), customer selection (/a)
#   IMG_HOST    -> image-compress tool ("Nén ảnh"); requires login
#   ADMIN_HOST  -> site administration + settings (admins only)
#   THIEP_HOST  -> online wedding invitations (thiep.mstudo.com/<slug>)
# Leave unset for local dev / *.vercel.app (the full app runs on one host).
NEXT_PUBLIC_MAIN_HOST=mstudo.com
NEXT_PUBLIC_APP_HOST=album.mstudo.com
NEXT_PUBLIC_IMG_HOST=img.mstudo.com
NEXT_PUBLIC_ADMIN_HOST=admin.mstudo.com
NEXT_PUBLIC_THIEP_HOST=thiep.mstudo.com

# Cloudflare Turnstile CAPTCHA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key

# ── Custom domains (studio white-label) ───────────────────────────────────
# Optional: lets studios connect their own domain (studio.com) from the site
# builder and have it auto-registered on the hosting project. Without these,
# the domain is saved + DNS guidance shown, but you must add it in Vercel
# (Project → Domains) manually. Create a token at vercel.com/account/tokens.
VERCEL_TOKEN=your-vercel-api-token
VERCEL_PROJECT_ID=your-vercel-project-id
VERCEL_TEAM_ID=your-vercel-team-id   # only if the project is under a team

# ── Zalo tự động nhắn tin (CHỈ gói Studio) ─────────────────────────────────
# Tính năng: mỗi studio tự kết nối kênh Zalo của họ tại Dashboard → Tin nhắn.
#   • OA (chính thống): studio cấp quyền Official Account qua OAuth → gửi ZNS.
#   • Cá nhân: studio đăng nhập tài khoản Zalo cá nhân bằng QR (zca-js).
# Xem supabase/migrations/studio_zalo.sql + src/lib/zalo/.
#
# Zalo App dùng CHUNG cho nền tảng (tạo tại https://developers.zalo.me → app có
# sản phẩm Official Account). Bỏ trống ZALO_OA_* nếu chỉ dùng kênh cá nhân.
#   ZALO_OA_APP_ID       -> App ID của Zalo App
#   ZALO_OA_APP_SECRET   -> App Secret (server only, BÍ MẬT)
#   ZALO_OA_REDIRECT_URI -> phải trùng "Redirect URI" khai báo trên Zalo App,
#                           vd https://mstudo.com/api/studio/zalo/oa/callback
ZALO_OA_APP_ID=
ZALO_OA_APP_SECRET=
ZALO_OA_REDIRECT_URI=

# Khoá mã hoá phiên đăng nhập Zalo CÁ NHÂN trước khi lưu DB (AES-256-GCM).
# Bỏ trống → tự dùng OAUTH_STATE_SECRET / SUPABASE_SERVICE_ROLE_KEY. Nên đặt
# một chuỗi ngẫu nhiên riêng ở production.
ZALO_SESSION_SECRET=

# Kênh cá nhân cần cài thư viện KHÔNG chính thức zca-js (đã khai optionalDependencies).
# LƯU Ý: tự động hoá tài khoản Zalo cá nhân vi phạm điều khoản Zalo và có thể bị
# khoá tài khoản — chỉ bật khi studio chấp nhận rủi ro. Kênh OA thì an toàn.

# ── Trợ lý tư vấn tự động (chatbox AI trên website vieetjk.com) ──────────────
# CÁCH 1 (đơn giản): chỉ 1 API Gemini (có gói MIỄN PHÍ).
#   Tạo key ở https://aistudio.google.com → "Get API key".
GEMINI_API_KEY=
GEMINI_MODEL=            # tuỳ chọn, mặc định gemini-flash-latest
#
# CÁCH 2 (khuyên dùng): NHIỀU API cùng lúc để dự phòng/gộp quota. Bot thử lần
# lượt, cái nào lỗi/hết hạn mức thì tự chuyển sang cái kế tiếp. Đặt CHAT_PROVIDERS
# là JSON mảng (ưu tiên theo thứ tự). Hỗ trợ:
#   type "gemini"  → Google Gemini
#   type "openai"  → mọi API chuẩn OpenAI (OpenAI, OpenRouter, DeepSeek, Groq…)
#                    kèm baseUrl. Nếu đặt CHAT_PROVIDERS thì nó ĐƯỢC ƯU TIÊN,
#                    GEMINI_API_KEY ở trên chỉ dùng khi CHAT_PROVIDERS trống.
#   type "anthropic" → Claude API trực tiếp (api.anthropic.com).
#   type "responses" → OpenAI Responses API (wire_api="responses"), dùng cho
#                    Codex/reseller. Có thêm "effort" (low|medium|high|xhigh).
#                    Vd: {"type":"responses","key":"...","model":"gpt-5.6-sol",
#                         "baseUrl":"https://codex.hungnguyen.codes/v1","effort":"medium"}
# Ví dụ (viết trên MỘT dòng khi dán vào Vercel):
# CHAT_PROVIDERS=[{"type":"gemini","key":"AIza...","model":"gemini-flash-latest"},{"type":"openai","key":"sk-or-...","model":"deepseek/deepseek-chat","baseUrl":"https://openrouter.ai/api/v1"},{"type":"openai","key":"sk-...","model":"gpt-4o-mini"}]
CHAT_PROVIDERS=

# ── HỘP THƯ HỢP NHẤT (Dashboard → Kinh doanh → Hộp thư) ─────────────────────
# Gom tin nhắn khách từ Zalo OA, Zalo cá nhân, Facebook Messenger, Instagram DM
# và chatbox website về một chỗ. AI (dùng lại CHAT_PROVIDERS ở trên) trả lời
# trước; nhân viên bấm "Tôi tiếp quản" là bot ngừng.
# Xem supabase/migrations/inbox_unified.sql + src/lib/inbox/.
#
# ▸ Facebook Messenger & Instagram DM — cần một Meta App (developers.facebook.com)
#   có sản phẩm Messenger + Instagram. Khai MỘT webhook cho cả hai:
#     Callback URL  https://<tên-miền>/api/inbox/webhook/meta
#     Verify Token  = giá trị META_VERIFY_TOKEN bên dưới (bạn tự đặt, chuỗi bất kỳ)
#     Sự kiện       messages
#   Page Access Token của TỪNG trang thì studio tự dán trong Dashboard → Hộp thư
#   → Kênh (lưu đã mã hoá, không để trong env).
META_APP_SECRET=         # App Secret của Meta App — dùng kiểm chữ ký webhook
META_VERIFY_TOKEN=       # chuỗi ngẫu nhiên bạn tự đặt, dán lại y hệt bên Meta
META_GRAPH_BASE=         # tuỳ chọn, mặc định https://graph.facebook.com/v21.0

# ▸ Zalo OA — khai webhook trong Zalo App (mục Webhook):
#     URL  https://<tên-miền>/api/inbox/webhook/zalo
#   Zalo ký sự kiện bằng OA Secret Key. Bỏ trống thì rơi về ZALO_OA_APP_SECRET.
ZALO_OA_WEBHOOK_SECRET=

# ▸ Zalo cá nhân — KHÔNG có webhook. Muốn NHẬN tin phải chạy thêm tiến trình
#   lắng nghe trên máy studio hoặc một VPS nhỏ:
#     npm run inbox:zalo-worker
#
# ▸ TikTok — nối qua CẦU NỐI (đối tác nhắn tin được TikTok công nhận), vì
#   Business Messaging API còn beta. Đối tác đẩy tin vào cùng cửa /api/inbox/
#   ingest; URL cầu nối để gửi ra thì khai trong giao diện (Hộp thư → Kênh),
#   không phải ở đây. Cần chạy thêm migrations/inbox_tiktok.sql.
#
#   Cả hai kênh trên xác thực với app bằng bí mật dùng chung dưới đây (đặt cùng
#   giá trị ở cả hai phía). Để trống = cửa /api/inbox/ingest bị KHOÁ hẳn.
INBOX_INGEST_SECRET=

# ── Bổ sung: 14 biến code có đọc mà file mẫu này từng thiếu ─────────────────
# (Danh sách đầy đủ 50 biến kèm cách xử lý khi chuyển đổi: docs/bien-moi-truong.md)

# Google Calendar — đồng bộ lịch chụp. Phải trùng tuyệt đối một dòng trong
# "Authorized redirect URIs" ở Google Cloud Console.
GOOGLE_CALENDAR_REDIRECT_URI=      # vd https://mstudo.com/api/gcal/callback

# Referer khai kèm khi gọi Drive API bằng GOOGLE_API_KEY, cho khớp giới hạn
# HTTP referrer của khoá. Bỏ trống → code tự suy ra từ host.
GOOGLE_API_REFERER=                # vd https://mstudo.com

# Host dựng link trong email BÁO CHO CHỦ STUDIO khi khách báo đã chuyển khoản
# (api/c/[token]) hoặc chấp nhận báo giá (api/quote/[token]) — link trỏ vào
# /dashboard/studio/... Bỏ trống → email vẫn gửi, chỉ không có nút bấm.
# Thường bằng NEXT_PUBLIC_MAIN_HOST. Hai email này còn cần RESEND_API_KEY.
NEXT_PUBLIC_STUDIO_HOST=

# Ký tham số "state" khi nối Google Drive / Zalo. Bỏ trống → tự dùng
# SUPABASE_SERVICE_ROLE_KEY. Nên đặt chuỗi ngẫu nhiên riêng ở production.
OAUTH_STATE_SECRET=

# Thông báo đẩy (web push). HAI khoá là MỘT CẶP — tạo bằng:
#   npx web-push generate-vapid-keys
# Đổi cặp khoá => mọi thiết bị đã đăng ký phải bật lại thông báo.
# Bỏ trống cả hai => tắt push, chuông thông báo trong app vẫn chạy.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                     # mặc định mailto:hello@mstudo.com

# Gửi email (Resend). Bỏ trống => không gửi được email.
RESEND_API_KEY=
EMAIL_FROM=                        # mặc định "mstudo <onboarding@resend.dev>"

# Giới hạn tần suất gọi API (Upstash Redis). Bỏ trống => không giới hạn.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App desktop cho gói Studio (API /api/desktop/version).
DESKTOP_LATEST_VERSION=            # vd 1.0.3
DESKTOP_UPDATE_NOTE=               # tuỳ chọn, mô tả ngắn bản mới
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=  # link tải bản cài
# Repo GitHub chứa Releases của bản cài (dạng chu-so-huu/ten-repo). Bỏ trống →
# vieetjk01/Studio. PHẢI là repo CÔNG KHAI: trang Releases và GitHub API của một
# repo riêng tư trả 404 cho trình duyệt của studio.
NEXT_PUBLIC_DESKTOP_RELEASES_REPO=
